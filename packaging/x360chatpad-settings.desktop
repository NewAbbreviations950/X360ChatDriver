[Desktop Entry]
Type=Application
Name=X360 Chatpad Settings
Comment=Remap the Xbox 360 chatpad and check controller status
Exec=@BIN_DIR@/x360chatpad-tray --settings
Icon=x360chatpad
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=xbox;360;chatpad;controller;keyboard;
StartupWMClass=x360chatpad
